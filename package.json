{
  "name": "neuroscan",
  "version": "0.1.0",
  "description": "NeuroScan mono-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter neuroscan-desktop dev",
    "build": "bun run --filter neuroscan-desktop build",
    "tauri:dev": "bun run --filter neuroscan-desktop tauri dev",
    "tauri:build": "bun run --filter neuroscan-desktop tauri build"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "packageManager": "bun@1.0.0"
}
