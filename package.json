{
  "name": "neuroscan",
  "version": "0.1.0",
  "description": "NeuroScan mono-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @neuroscan/desktop dev",
    "build": "pnpm --filter @neuroscan/desktop build",
    "lint": "biome lint apps/desktop/src",
    "lint:fix": "biome check --write apps/desktop/src",
    "typecheck": "pnpm --filter @neuroscan/desktop exec tsc --noEmit",
    "test": "pnpm --filter @neuroscan/desktop test",
    "tauri:dev": "pnpm --filter @neuroscan/desktop tauri dev",
    "tauri:build": "pnpm --filter @neuroscan/desktop tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
